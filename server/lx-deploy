# --- Things that touch the machine -------------------------------------------------------------


class Server:
    """Commands and HTTP requests. Tests replace this with a fake."""

    def sh(self, command, *, input=None, check=True, quiet=False, timeout=900):
        result = subprocess.run(
            command,
            input=input,
            capture_output=True,
            timeout=timeout,
        )
        if check and result.returncode != 0:
            # Only the command's name: its output may hold paths or settings.
            raise CommandFailed(command[:3], result.returncode)
        return result

    def compose(self, *args, check=True, timeout=900):
        return self.sh(
            ["docker", "compose", "--project-directory", str(L.etc), *args], check=check, timeout=timeout
        )

    def request(self, target, method, path, headers=None, body=None):
        """target: a public host name (HTTPS to this server's own Caddy, with that name's real
        certificate) or a loopback port number (plain HTTP). Returns (status, headers, body)."""
        headers = {"User-Agent": "lx-deploy", **(headers or {})}
        if isinstance(target, int):
            connection = http.client.HTTPConnection("127.0.0.1", target, timeout=10)
        else:
            connection = LocalHTTPS(target)
        try:
            connection.request(method, path, body=body, headers=headers)
            response = connection.getresponse()
            return response.status, response.getheaders(), response.read(1_000_000)
        finally:
            connection.close()

    def wait(self, seconds):
        time.sleep(seconds)


class LocalHTTPS(http.client.HTTPSConnection):
    """HTTPS to 127.0.0.1:443 with the public name for SNI and certificate checks, so the
    checks test Caddy and its real certificates without depending on DNS from the server."""

    def __init__(self, host):
        super().__init__(host, 443, timeout=10, context=ssl.create_default_context())

    def connect(self):
        sock = socket.create_connection(("127.0.0.1", 443), self.timeout)
        self.sock = self._context.wrap_socket(sock, server_hostname=self.host)


class CommandFailed(Exception):
    def __init__(self, command, code):
        super().__init__(f"{' '.join(command)} exited with {code}")


@contextlib.contextmanager
def lock(wait=False):
    L.state.mkdir(parents=True, exist_ok=True)
    with open(L.state / "lock", "w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except BlockingIOError:
            raise Busy() from None
        yield


class Busy(Exception):
    pass


# --- release.json ------------------------------------------------------------------------------


def validate_release(text):
    """Returns (release, errors). release.json is data, never code (DEPLOYMENT.md § 3)."""
    if text is None:
        return None, ["release.json is missing"]
    if len(text.encode()) > 4096:
        return None, ["release.json is larger than 4 KB"]
    try:
        data = json.loads(text)
    except ValueError:
        return None, ["release.json is not valid JSON"]
    if not isinstance(data, dict):
        return None, ["release.json must be an object"]
    errors = [f"unknown field {key!r}" for key in data if key not in ("images", "checks", "run")]
    images = data.get("images")
    if not isinstance(images, dict):
        errors.append("images must be an object of service: image")
        images = {}
    for name, reference in images.items():
        if name not in KNOWN:
            errors.append(f"unknown service {name!r}")
            continue
        match = IMAGE.fullmatch(reference) if isinstance(reference, str) else None
        if not match or match["name"] != name:
            errors.append(f"{name}: the image must be ghcr.io/gzjwyg/{name}@sha256:<64 hex>")
    for name in SERVICES:
        if name not in images:
            errors.append(f"images must name {name}")
    checks = data.get("checks", "basic")
    if checks not in ("basic", "full"):
        errors.append("checks must be basic or full")
    run = data.get("run", "")
    if not isinstance(run, str) or len(run) > 100 or not run.isprintable():
        errors.append("run must be a short line of text")
    if errors:
        return None, errors
    return {"images": dict(images), "checks": checks, "run": run}, []


def short(reference):
    return reference.split("@sha256:")[1][:12] if reference and "@sha256:" in reference else "-"


# --- Settings files ----------------------------------------------------------------------------


def read_env(path):
    """KEY=VALUE lines, as Docker Compose and systemd both read them (single quotes optional)."""
    values = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1]
        values[key.strip()] = value
    return values


def write_env(path, values, header):
    for key, value in values.items():
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            raise ValueError(f"bad setting name {key!r}")
        if "'" in value or "\n" in value or "\r" in value:
            raise ValueError(f"{key}: a value cannot contain a single quote or a line break")
    lines = [f"# {header}", "# Root only (mode 600). Never copy it into Git, a chat or a screenshot."]
    lines += [f"{key}='{value}'" for key, value in values.items()]
    atomic_write(path, "\n".join(lines) + "\n", 0o600)


def atomic_write(path, text, mode, owner=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(temporary, mode)
        if owner is not None:
            os.chown(temporary, owner, owner)
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temporary)
        raise


def load_state():
    path = L.state / "state.json"
    return json.loads(path.read_text()) if path.exists() else {}


def save_state(state):
    atomic_write(L.state / "state.json", json.dumps(state, indent=2) + "\n", 0o600)


def write_dotenv(images, commit):
    """Docker Compose reads the image references from .env in the project folder."""
    lines = [f"# Written by lx-deploy from release.json at {commit[:12]}. Do not edit."]
    for name in KNOWN:
        if name in images:
            lines.append(f"LX_IMAGE_{name.upper().replace('-', '_')}={images[name]}")
    atomic_write(L.etc / ".env", "\n".join(lines) + "\n", 0o644)


# --- The repository ----------------------------------------------------------------------------


def git(server, *args):
    return server.sh(["git", "-C", str(L.repo), "-c", "core.hooksPath=/dev/null", *args])


def fetch(server):
    """Brings the checkout to the newest commit of main and returns it. Nothing in it is run."""
    git(server, "fetch", "--quiet", "origin", BRANCH)
    git(server, "checkout", "--quiet", "--force", "--detach", "FETCH_HEAD")
    git(server, "clean", "-fdxq")
    commit = git(server, "rev-parse", "HEAD").stdout.decode().strip()
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        raise ValueError("git returned an unexpected commit id")
    return commit


def config_files():
    """(file in the repository, file on the server, mode). apply-config is the only writer."""
    files = [
        ("server/compose.yaml", L.etc / "compose.yaml", 0o644),
        ("caddy/Caddyfile", L.etc / "caddy" / "Caddyfile", 0o644),
        ("caddy/sites.caddy", L.etc / "caddy" / "sites.caddy", 0o644),
        ("caddy/common.caddy", L.etc / "caddy" / "common.caddy", 0o644),
        ("caddy/account.caddy", L.etc / "caddy" / "account.caddy", 0o644),
        ("server/watch.json", L.etc / "watch.json", 0o600),
        ("server/monitor/watch.py", L.monitor / "watch.py", 0o755),
        ("server/lx-deploy", L.program, 0o755),
    ]
    units = L.repo / "server" / "systemd"
    if units.is_dir():
        for unit in sorted(units.iterdir()):
            if unit.suffix in (".service", ".timer"):
                files.append((f"server/systemd/{unit.name}", L.systemd / unit.name, 0o644))
    return files


def config_drift():
    return [
        (source, target, mode)
        for source, target, mode in config_files()
        if (L.repo / source).exists()
        and (not target.exists() or target.read_bytes() != (L.repo / source).read_bytes())
    ]


# --- Static files ------------------------------------------------------------------------------


def switch_link(link, target):
    """Points link at target in one step, so Caddy never sees a half-copied folder."""
    link.parent.mkdir(parents=True, exist_ok=True)
    temporary = link.with_name(f".{link.name}.{secrets.token_hex(4)}")
    os.symlink(target, temporary)
    os.replace(temporary, link)


def link_target(link):
    return os.readlink(link) if link.is_symlink() else None


def make_public(folder):
    """Plain files and folders only, readable by Caddy. A link in an image could point Caddy at
    any file on the server, so links are refused."""
    for root, dirs, files in os.walk(folder):
        for name in dirs + files:
            path = Path(root) / name
            if path.is_symlink():
                raise ValueError(f"the static files contain a link ({path.relative_to(folder)})")
        os.chmod(root, 0o755)
        for name in files:
            os.chmod(Path(root) / name, 0o644)


def extract_www(server, name, image):
    """Copies /app/www out of an image (DEPLOYMENT.md § 9a) without running it."""
    releases = L.www / ".releases"
    target = releases / f"{name}-{short(image)}"
    if target.is_dir():
        return target
    releases.mkdir(parents=True, exist_ok=True)
    temporary = releases / f".{target.name}.{secrets.token_hex(4)}"
    container = server.sh(["docker", "create", image]).stdout.decode().strip()
    try:
        server.sh(["docker", "cp", f"{container}:/app/www", str(temporary)])
    finally:
        server.sh(["docker", "rm", container], check=False)
    try:
        if not (temporary / "index.html").is_file():
            raise ValueError(f"{name}: the image has no /app/www/index.html")
        make_public(temporary)
        os.replace(temporary, target)
    except BaseException:
        shutil.rmtree(temporary, ignore_errors=True)
        raise
    return target


def sync_home():
    """The homepage is this repository's home/: static files only, copied, never run."""
    source = L.repo / "home"
    if not (source / "index.html").is_file():
        return None
    digest = hashlib.sha256()
    files = []
    for path in sorted(source.rglob("*")):
        if path.is_symlink():
            raise ValueError("home/ contains a link")
        if path.is_file():
            if path.suffix.lower() not in HOME_FILES:
                raise ValueError(f"home/ contains a file type that is not served: {path.name}")
            relative = path.relative_to(source)
            files.append(relative)
            digest.update(str(relative).encode() + b"\0" + path.read_bytes() + b"\0")
    target = L.www / ".releases" / f"home-{digest.hexdigest()[:12]}"
    if not target.is_dir():
        temporary = target.with_name(f".{target.name}.{secrets.token_hex(4)}")
        for relative in files:
            (temporary / relative).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(source / relative, temporary / relative)
        make_public(temporary)
        os.replace(temporary, target)
    changed = link_target(L.www / "home") != str(target)
    switch_link(L.www / "home", target)
    return changed


def prune(server, keep):
    """Keeps the static files and images of the current and previous release only."""
    releases = L.www / ".releases"
    wanted = {Path(link_target(L.www / name) or "").name for name in ("home", "rat-webs", "nobody")}
    wanted |= {f"{name}-{short(image)}" for images in keep for name, image in images.items()}
    if releases.is_dir():
        for folder in releases.iterdir():
            if folder.is_dir() and folder.name not in wanted and not folder.name.startswith("."):
                shutil.rmtree(folder, ignore_errors=True)
    digests = {image.split("@")[1] for images in keep for image in images.values()}
    for name in KNOWN:
        listing = server.sh(
            [
                "docker",
                "image",
                "ls",
                "--digests",
                "--format",
                "{{.Digest}} {{.ID}}",
                f"ghcr.io/gzjwyg/{name}",
            ],
            check=False,
        )
        for line in listing.stdout.decode().splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[0] not in digests:
                server.sh(["docker", "image", "rm", parts[1]], check=False)


# --- Backups -----------------------------------------------------------------------------------


def backup(server, name):
    """Runs the service's own backup command (its image's README) into /srv/lx/backups/<name>."""
    folder = L.srv / "backups" / name
    folder.mkdir(parents=True, exist_ok=True)
    if os.geteuid() == 0:
        os.chown(folder, APP_UID, APP_UID)
    os.chmod(folder, 0o700)
    commands = (SERVICES.get(name) or JOBS[name])["backup"]
    for command in commands:
        server.compose(
            "run",
            "--rm",
            "--no-deps",
            "-T",
            "--volume",
            f"{folder}:/data/backups",
            name,
            *command,
            timeout=3600,
        )


def newest(folder, pattern):
    files = [path for path in folder.glob(pattern) if path.is_file()]
    return max(files, key=lambda path: (path.stat().st_mtime, path.name)) if files else None


def counts(database, tables, integrity=False):
    with contextlib.closing(
        sqlite3.connect(database.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
    ) as db:
        if integrity and db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
            raise ValueError("integrity check failed")
        return {table: db.execute(f'SELECT count(*) FROM "{table}"').fetchone()[0] for table in tables}


# --- Checks (DEPLOYMENT.md § 6; DRY-RUN.md part 1) ---------------------------------------------


class Checks:
    def __init__(self, server):
        self.server = server
        self.lines = []

    @property
    def passed(self):
        return all(ok for ok, _ in self.lines)

    def check(self, text, function):
        try:
            ok = bool(function())
        except Exception as error:  # a check that cannot run is a failed check
            ok, text = False, f"{text} ({type(error).__name__})"
        self.lines.append((ok, text))
        return ok

    def get(self, target, path, method="GET", headers=None):
        return self.server.request(target, method, path, headers)

    def healthy(self, name):
        status, _, body = self.get(SERVICES[name]["port"], "/healthz")
        return status == 200 and body.strip() == b"ok"

    def wait_healthy(self, name, seconds=90):
        for _ in range(seconds // 3):
            with contextlib.suppress(Exception):
                if self.healthy(name):
                    return True
            self.server.wait(3)
        return self.healthy(name)

    def basic(self):
        for name in SERVICES:
            self.check(f"{name} answers its health check", lambda name=name: self.healthy(name))
        self.check(f"the homepage opens over HTTPS ({DOMAIN})", lambda: self.page(DOMAIN, "/"))
        self.check("the Library opens over HTTPS", lambda: self.page(f"library.{DOMAIN}", "/"))
        self.check("Nobody opens over HTTPS", lambda: self.page(f"forum.{DOMAIN}", "/"))
        self.check("the sign-in service answers over HTTPS", self.provider)
        for host in PUBLIC_HOSTS:
            self.check(
                f"{host} refuses /internal/, PHP probes and dotfiles", lambda host=host: self.refuses(host)
            )
        self.check(f"account.{DOMAIN} refuses /token and /userinfo", self.provider_private)
        for host, cookie in ((f"library.{DOMAIN}", "__Host-library"), (f"forum.{DOMAIN}", "__Host-forum")):
            self.check(
                f"{host} sign-in cookies are host-only, Secure and HttpOnly",
                lambda host=host, cookie=cookie: self.cookies(host, cookie),
            )
        self.check("the Library's staff paths allow Nobody's origin and refuse others", self.staff_origin)

    def page(self, host, path):
        status, headers, _ = self.get(host, path)
        names = {key.lower() for key, _ in headers}
        return status == 200 and "strict-transport-security" in names

    def provider(self):
        status, _, body = self.get(f"account.{DOMAIN}", "/.well-known/openid-configuration")
        return status == 200 and json.loads(body).get("issuer") == f"https://account.{DOMAIN}"

    def refuses(self, host):
        paths = ["/internal/accounts/names", "/wp-login.php", "/api/.env", "/.git/config"]
        return all(self.get(host, path)[0] == 404 for path in paths)

    def provider_private(self):
        host = f"account.{DOMAIN}"
        return self.get(host, "/token", "POST")[0] == 404 and self.get(host, "/userinfo")[0] == 404

    def cookies(self, host, name):
        status, headers, _ = self.get(host, "/api/auth/login?return_to=/")
        location = dict((k.lower(), v) for k, v in headers).get("location", "")
        set_cookies = [value for key, value in headers if key.lower() == "set-cookie"]
        if status not in (302, 303, 307) or not location.startswith(f"https://account.{DOMAIN}/authorize?"):
            return False
        if not set_cookies:
            return False
        for value in set_cookies:
            parts = [part.strip().lower() for part in value.split(";")]
            if not value.startswith(name) or "secure" not in parts or "httponly" not in parts:
                return False
            if any(part.startswith("domain=") for part in parts):
                return False
        return True

    def staff_origin(self):
        host, path = f"library.{DOMAIN}", "/staff/comment-reports"
        forum = f"https://forum.{DOMAIN}"
        preflight = {"Access-Control-Request-Method": "POST"}
        status, headers, _ = self.get(host, path, "OPTIONS", {"Origin": forum, **preflight})
        allowed = dict((k.lower(), v) for k, v in headers).get("access-control-allow-origin")
        if status not in (200, 204) or allowed != forum:
            return False
        stranger = "https://example.invalid"
        status, headers, _ = self.get(host, path, "OPTIONS", {"Origin": stranger, **preflight})
        if status != 403 or "access-control-allow-origin" in {k.lower() for k, _ in headers}:
            return False
        return self.get(host, f"{path}/lx-deploy-check", "POST", {"Origin": stranger})[0] == 403

    def full(self):
        before = {}
        self.check("the databases can be read", lambda: before.update(self.live_counts()) or True)
        self.server.compose("stop", "shared-account")
        try:
            self.check(
                "with sign-in stopped, the Library still opens",
                lambda: self.page(f"library.{DOMAIN}", "/") and self.healthy("rat-webs"),
            )
            self.check(
                "with sign-in stopped, Nobody still opens",
                lambda: self.page(f"forum.{DOMAIN}", "/") and self.healthy("nobody"),
            )
        finally:
            self.server.compose("start", "shared-account")
        self.check("sign-in comes back after a restart", lambda: self.wait_healthy("shared-account"))
        self.server.compose("restart")
        for name in SERVICES:
            self.check(
                f"{name} comes back after a restart of everything", lambda name=name: self.wait_healthy(name)
            )
        self.check("the data is still there after the restart", lambda: self.live_counts() == before)
        for name, facts in SERVICES.items():
            self.check(
                f"{name}: a fresh backup restores with the same counts",
                lambda name=name, facts=facts: self.restores(name, facts),
            )
        self.check("the backup, watch and update timers are scheduled", self.timers)

    def live_counts(self):
        return {
            name: counts(L.srv / name / facts["database"], facts["tables"])
            for name, facts in SERVICES.items()
        }

    def restores(self, name, facts):
        backup(self.server, name)
        latest = newest(L.srv / "backups" / name, facts["backup_glob"])
        if latest is None:
            return False
        with tempfile.TemporaryDirectory(prefix="lx-restore-") as scratch:
            copy = Path(scratch) / latest.name
            shutil.copyfile(latest, copy)
            live = counts(L.srv / name / facts["database"], facts["tables"])
            return counts(copy, facts["tables"], integrity=True) == live

    def timers(self):
        listing = self.server.sh(["systemctl", "list-timers", "--all", "--no-legend", "--no-pager"])
        text = listing.stdout.decode()
        return all(timer in text for timer in TIMERS)


def run_checks(server, level):
    checks = Checks(server)
    try:
        checks.basic()
        if level == "full":
            checks.full()
    except Exception as error:  # e.g. a compose command in the full checks failed
        checks.lines.append((False, f"the checks stopped early ({type(error).__name__})"))
    return checks


# --- Reports -----------------------------------------------------------------------------------


def report(commit, state, title, lines=(), comment=True):
    """A commit status, and for results an issue comment, on gzjwyg/deploy. Only pass/fail lines
    and versions: never logs, settings, addresses or secrets. A failed report never stops a
    deployment."""
    say(f"{state}: {title}")
    for line in lines:
        say(f"  {line}")
    token_file = L.etc / "report.token"
    if not token_file.exists():
        return
    settings = json.loads((L.etc / "deploy.json").read_text()) if (L.etc / "deploy.json").exists() else {}
    token = token_file.read_text().strip()

    def post(path, body):
        request = urllib.request.Request(
            f"https://api.github.com/repos/{REPOSITORY}{path}",
            data=json.dumps(body).encode(),
            method="POST",
            headers={
                "Authorization": f"Bearer {token}",
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2022-11-28",
                "User-Agent": "lx-deploy",
            },
        )
        try:
            urllib.request.urlopen(request, timeout=20).close()
        except (urllib.error.URLError, OSError) as error:
            say(f"  (the report to GitHub failed: {type(error).__name__})")

    post(f"/statuses/{commit}", {"state": state, "context": "lx-deploy", "description": title[:140]})
    issue = settings.get("report_issue")
    if comment and state != "pending" and isinstance(issue, int):
        mark = {"success": "✅", "failure": "❌", "error": "❌"}.get(state, "")
        body = "\n".join([f"{mark} **{title}** (`{commit[:12]}`)", "", *[f"- {line}" for line in lines]])
        post(f"/issues/{issue}/comments", {"body": body[:60000]})


def check_lines(checks):
    return [f"{'pass' if ok else 'FAIL'}: {text}" for ok, text in checks.lines]


def version_lines(images, changed=()):
    return [f"{name} `{short(image)}`{' (new)' if name in changed else ''}" for name, image in images.items()]


# --- Commands ----------------------------------------------------------------------------------


def start(server, images, commit, links):
    write_dotenv(images, commit)
    for name, target in links.items():
        switch_link(L.www / name, target)
    return (
        server.compose(
            "up", "-d", "--wait", "--wait-timeout", "180", *SERVICES, check=False, timeout=600
        ).returncode
        == 0
    )


def cmd_run(server, force=False):
    commit = fetch(server)
    text = (L.repo / "release.json").read_text() if (L.repo / "release.json").exists() else None
    release, errors = validate_release(text)
    state = load_state()
    key = f"{commit} {release['run'] if release else ''}"
    if state.get("handled") == key and not force:
        return 0
    state["handled"] = key
    save_state(state)
    if errors:
        report(commit, "failure", "release.json refused; nothing was changed", errors)
        return 1
    try:
        return deploy(server, commit, release, state, force)
    except Exception as error:
        report(
            commit,
            "error",
            f"lx-deploy stopped unexpectedly ({type(error).__name__}); "
            "the owner can look with: sudo journalctl -u lx-deploy",
        )
        raise


def deploy(server, commit, release, state, force):
    drift = config_drift()
    note = (
        [
            f"{len(drift)} server file(s) changed in the repository and wait for the owner: "
            "sudo lx-deploy apply-config"
        ]
        if drift
        else []
    )
    current = state.get("current", {}).get("images", {})
    images = release["images"]
    changed = [name for name in images if current.get(name) != images[name]]
    try:
        home_changed = sync_home()
    except (ValueError, OSError) as error:
        report(commit, "failure", "Not deployed: home/ was refused; nothing was changed", [str(error), *note])
        return 1
    if not changed and release["run"] == state.get("run") and not force:
        save_state(state)
        lines = note + (["the homepage was updated"] if home_changed else [])
        report(commit, "success", "No version changed", lines, comment=bool(lines))
        return 0
    report(commit, "pending", "Deploying")
    try:
        for name in changed:
            server.sh(["docker", "pull", "--quiet", images[name]], timeout=1800)
        if current:
            for name in changed:
                if name in SERVICES:
                    backup(server, name)
        links = {
            name: extract_www(server, name, images[name])
            for name in changed
            if SERVICES.get(name, {}).get("www")
        }
    except (CommandFailed, ValueError, OSError, subprocess.TimeoutExpired) as error:
        save_state(state)
        report(
            commit,
            "failure",
            "Not deployed: preparing the new versions failed; nothing was changed",
            [str(error) if isinstance(error, (CommandFailed, ValueError)) else type(error).__name__, *note],
        )
        return 1
    old_links = {name: link_target(L.www / name) for name in links}
    started = start(server, images, commit, links)
    checks = run_checks(server, release["checks"])
    lines = version_lines(images, changed) + [f"checks: {release['checks']}"] + check_lines(checks) + note
    if started and checks.passed:
        state.update(
            previous=state.get("current"), current={"commit": commit, "images": images}, run=release["run"]
        )
        save_state(state)
        prune(server, [images, current])
        report(commit, "success", f"Deployed and checked ({release['checks']})", lines)
        return 0
    if not started:
        lines.insert(0, "FAIL: the new versions did not all start healthy")
    if not current:
        save_state(state)
        report(commit, "failure", "The first deployment failed its checks; nothing to go back to", lines)
        return 1
    back = {name: Path(target) for name, target in old_links.items() if target}
    restarted = start(server, current, state["current"]["commit"], back)
    after = run_checks(server, "basic")
    lines += ["", "Put the previous versions back:"] + version_lines(current) + check_lines(after)
    if not restarted:
        lines.append("FAIL: the previous versions did not all start healthy either")
    save_state(state)
    report(commit, "failure", "Checks failed; the previous versions are running again", lines)
    return 1


def cmd_rollback(server):
    state = load_state()
    previous = (state.get("previous") or {}).get("images")
    if not previous:
        say("There is no previous release to go back to.")
        return 1
    links = {
        name: extract_www(server, name, previous[name])
        for name in SERVICES
        if SERVICES[name]["www"] and name in previous
    }
    started = start(server, previous, state["previous"]["commit"], links)
    checks = run_checks(server, "basic")
    lines = version_lines(previous) + check_lines(checks)
    if started and checks.passed:
        state["previous"], state["current"] = state["current"], state["previous"]
        save_state(state)
        report(state["current"]["commit"], "success", "Rolled back by the owner", lines)
        return 0
    report(state["previous"]["commit"], "failure", "Rollback by the owner failed its checks", lines)
    return 1


def cmd_check(server, level):
    checks = run_checks(server, level)
    for line in check_lines(checks):
        say(line)
    return 0 if checks.passed else 1


def cmd_backup(server, which):
    names = KNOWN if which == "all" else [which]
    env = read_env(L.etc / ".env")
    failed = False
    for name in names:
        if name in JOBS:
            data = L.srv / name
            if f"LX_IMAGE_{name.upper()}" not in env or not data.is_dir() or not any(data.iterdir()):
                say(f"{name}: not set up yet; skipped")
                continue
        try:
            backup(server, name)
            say(f"{name}: backed up")
        except (CommandFailed, OSError, subprocess.TimeoutExpired) as error:
            reason = error if isinstance(error, CommandFailed) else type(error).__name__
            say(f"{name}: BACKUP FAILED ({reason})")
            failed = True
    return 1 if failed else 0


def cmd_status(_server):
    state = load_state()
    current = state.get("current") or {}
    say(f"Release: {current.get('commit', 'none yet')[:12]}")
    for line in version_lines(current.get("images", {})):
        say(f"  {line}")
    drift = config_drift() if L.repo.exists() else []
    if drift:
        say(f"{len(drift)} server file(s) wait for `sudo lx-deploy apply-config`.")
    return 0


def show_difference(source, target):
    new = source.read_text(encoding="utf-8", errors="replace").splitlines()
    old = target.read_text(encoding="utf-8", errors="replace").splitlines() if target.exists() else []
    diff = list(
        difflib.unified_diff(
            old, new, str(target), f"repository {source.relative_to(L.repo)}", lineterm="", n=2
        )
    )
    for line in diff[:300]:
        say(line)
    if len(diff) > 300:
        say(f"... and {len(diff) - 300} more lines")


MAIN_CADDYFILE = "import /etc/lx-deploy/caddy/Caddyfile\n"


def cmd_apply_config(server, yes=False):
    fetch(server)
    changes = config_drift()
    main_caddyfile = not L.caddyfile.exists() or L.caddyfile.read_text() != MAIN_CADDYFILE
    if not changes and not main_caddyfile:
        say("The server already has every file in the repository. Nothing to do.")
        return 0
    for source, target, _ in changes:
        say(f"\n=== {target}" + ("" if target.exists() else " (new)"))
        show_difference(L.repo / source, target)
    if main_caddyfile:
        say(f"\n=== {L.caddyfile}: will contain only the line `{MAIN_CADDYFILE.strip()}`")
    say("")
    if not yes:
        answer = input("Apply these changes? Type yes to apply: ").strip().lower()
        if answer != "yes":
            say("Nothing was changed.")
            return 1
    saved = L.state / "config-backups" / datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    saved.mkdir(parents=True, exist_ok=True)
    targets = [target for _, target, _ in changes] + ([L.caddyfile] if main_caddyfile else [])
    existed = {}
    for target in targets:
        existed[target] = target.exists()
        if target.exists():
            copy = saved / target.relative_to(target.anchor)
            copy.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, copy)

    def restore():
        for target in targets:
            copy = saved / target.relative_to(target.anchor)
            if existed[target]:
                shutil.copy2(copy, target)
            else:
                target.unlink(missing_ok=True)

    for source, target, mode in changes:
        atomic_write(target, (L.repo / source).read_text(encoding="utf-8"), mode)
    if main_caddyfile:
        atomic_write(L.caddyfile, MAIN_CADDYFILE, 0o644)
    try:
        server.sh(["caddy", "validate", "--adapter", "caddyfile", "--config", str(L.caddyfile)])
        if (L.etc / ".env").exists():
            server.compose("config", "--quiet")
    except CommandFailed as error:
        restore()
        say(f"A new file did not validate ({error}). The previous files are back; nothing changed.")
        return 1
    server.sh(["systemctl", "daemon-reload"])
    for target in targets:
        if target.suffix == ".timer" and not existed[target]:
            server.sh(["systemctl", "enable", "--now", target.name])
    if any(target.parent in (L.etc / "caddy", L.caddyfile.parent) for target in targets):
        server.sh(["systemctl", "reload-or-restart", "caddy"])
    if L.etc / "compose.yaml" in targets and (L.etc / ".env").exists():
        server.compose("up", "-d", "--wait", "--wait-timeout", "180", *SERVICES, check=False, timeout=600)
    say(f"Applied {len(targets)} file(s). The old ones are in {saved}.")
    if (L.etc / ".env").exists():
        return cmd_check(server, "basic")
    return 0


def token():
    return secrets.token_hex(32)


def ask(prompt, secret=False):
    reader = getpass.getpass if secret else input
    return reader(prompt).strip()


def cmd_init_secrets(server):
    """Creates every random secret that is missing and asks the owner for the rest. Never
    replaces a value that exists, never prints one."""
    L.env.mkdir(parents=True, exist_ok=True)
    os.chmod(L.env, 0o700)
    files = {name: read_env(L.env / f"{name}.env") for name in SERVICES}
    account, library, forum = files["shared-account"], files["rat-webs"], files["nobody"]
    watch = read_env(L.etc / "watch.env")
    report_lines = []

    def shared(key, holders):
        existing = {holder[key] for holder in holders if holder.get(key)}
        if len(existing) > 1:
            raise SystemExit(f"{key} differs between the settings files. Make them equal by hand first.")
        value = existing.pop() if existing else token()
        kept = any(holder.get(key) == value for holder in holders)
        report_lines.append(f"{key}: {'kept' if kept else 'created'}")
        for holder in holders:
            holder[key] = value

    shared("ACCOUNT_INTERNAL_SECRET", [account, library, forum])
    shared("NOBODY_INTERNAL_SECRET", [library, forum])
    for holder, label in ((account, "ACCOUNT_EMAIL_HASH_KEY"),):
        if not holder.get(label):
            holder[label] = token()
            report_lines.append(
                f"{label}: created. Never change it once accounts exist; keep a "
                "private copy with the off-server backups"
            )
        else:
            report_lines.append(f"{label}: kept")
    for holder, site in ((library, "Library"), (forum, "Nobody")):
        if not holder.get("ACCOUNT_CLIENT_SECRET"):
            holder["ACCOUNT_CLIENT_SECRET"] = token()
            report_lines.append(f"{site} sign-in client secret: created")

    if "ACCOUNT_SMTP_USER" not in account:
        say("\nSign-in codes are sent from a QQ mailbox (shared-account deploy/README.md § 2).")
        user = ask("  The QQ address (numbers@qq.com), or Enter to set it later: ")
        account["ACCOUNT_SMTP_USER"] = user
        account["ACCOUNT_SMTP_PASSWORD"] = (
            ask("  Its authorisation code (授权码, not the password): ", secret=True) if user else ""
        )
        report_lines.append("QQ mail: " + ("set" if user else "not set yet (no codes can be sent)"))

    if not library.get("RATWEBS_ADMIN_NAME") or not library.get("RATWEBS_ADMIN_PASSWORD_HASH"):
        say("\nThe Library's administrator page (/admin) needs a name and a password.")
        name = ask("  Administrator name: ")
        while True:
            password = ask("  Password (12 to 72 characters): ", secret=True)
            if 12 <= len(password.encode()) <= 72 and password == ask(
                "  The same password again: ", secret=True
            ):
                break
            say("  Too short, too long, or the two did not match. Again.")
        library["RATWEBS_ADMIN_NAME"] = name
        library["RATWEBS_ADMIN_PASSWORD_HASH"] = bcrypt_hash(server, password)
        report_lines.append("Library administrator: set (only the password's bcrypt hash is stored)")

    for key, label in (("DEEPSEEK_API_KEY", "DeepSeek"), ("ZHIPU_API_KEY", "Zhipu (embeddings)")):
        if key not in library:
            library[key] = ask(
                f"\n{label} API key for the Library's Ask, or Enter to leave Ask off: ", secret=True
            )
            report_lines.append(f"{key}: {'set' if library[key] else 'empty (Ask stays off)'}")

    if not watch.get("WATCH_TO"):
        watch["WATCH_TO"] = ask("\nEmail address for the server's alerts (package H): ")
        report_lines.append("alert address: " + ("set" if watch["WATCH_TO"] else "not set"))

    for name, values in files.items():
        write_env(L.env / f"{name}.env", values, f"Settings and secrets for {name} (lx-deploy init-secrets).")
    write_env(L.etc / "watch.env", watch, "Where the server's alerts go (lx-deploy init-secrets).")
    write_clients(library["ACCOUNT_CLIENT_SECRET"], forum["ACCOUNT_CLIENT_SECRET"])
    write_data_files(server)
    say("")
    for line in report_lines:
        say(f"- {line}")
    say("Done. No value was printed; they are only in /etc/lx-deploy/env/ (root, mode 600).")
    return 0


def owned(path, text, mode=0o600):
    atomic_write(path, text, mode, owner=APP_UID if os.geteuid() == 0 else None)


def write_clients(library_secret, forum_secret):
    """The provider's client registry (IDENTITY-V2.md § 3), in the account service's /data."""

    def client(host, port, secret):
        return {
            "secret": secret,
            "redirect_uri": f"https://{host}/api/auth/callback",
            "post_logout_redirect_uri": f"https://{host}/",
            "logout_uri": f"http://127.0.0.1:{port}/internal/oidc/logout",
        }

    registry = {
        "library": client(f"library.{DOMAIN}", 8787, library_secret),
        "forum": client(f"forum.{DOMAIN}", 8000, forum_secret),
    }
    owned(L.srv / "shared-account" / "clients.json", json.dumps(registry, indent=2) + "\n")


def release_image(name):
    release, _ = validate_release(
        (L.repo / "release.json").read_text() if (L.repo / "release.json").exists() else None
    )
    return release["images"].get(name) if release else None


def bcrypt_hash(server, password):
    """Hashes with the Library's own bcrypt, inside its image, without network; the password
    goes in on standard input, never on a command line."""
    image = release_image("rat-webs")
    if not image:
        raise SystemExit("release.json names no Library image yet; run init-secrets again after it does.")
    server.sh(["docker", "pull", "--quiet", image], timeout=1800)
    program = "import bcrypt, sys; print(bcrypt.hashpw(sys.stdin.buffer.read(), bcrypt.gensalt(12)).decode())"
    result = server.sh(
        [
            "docker",
            "run",
            "--rm",
            "-i",
            "--network",
            "none",
            "--read-only",
            "--entrypoint",
            "python",
            image,
            "-c",
            program,
        ],
        input=password.encode(),
    )
    hashed = result.stdout.decode().strip()
    if not re.fullmatch(r"\$2[aby]\$12\$[./A-Za-z0-9]{53}", hashed):
        raise SystemExit("The Library's image did not return a bcrypt hash.")
    return hashed


def write_data_files(server):
    names = L.srv / "shared-account" / "reserved-names.txt"
    if not names.exists():
        residents = resident_names(server)
        if not residents:
            say(
                "Note: Nobody's resident names could not be read; add them to "
                f"{names} by hand (shared-account deploy/README.md § 2)."
            )
        lines = ["# One complete name per line (shared-account deploy/README.md § 2)."]
        lines += list(dict.fromkeys(BASE_RESERVED_NAMES + residents))
        owned(names, "\n".join(lines) + "\n")
    moderation = L.srv / "rat-webs" / "moderation.txt"
    if not moderation.exists():
        owned(moderation, "")


def resident_names(server):
    """Nobody's residents' names and handles, from the content pack in its image."""
    image = release_image("nobody")
    if not image:
        return []
    program = (
        "const p=JSON.parse(require('fs').readFileSync('/app/web/src/content/pack/pack.json','utf8'));"
        "for(const r of p.personas){console.log(r.name.zh);console.log(r.name.en);console.log(r.handle)}"
    )
    try:
        server.sh(["docker", "pull", "--quiet", image], timeout=1800)
        result = server.sh(
            [
                "docker",
                "run",
                "--rm",
                "--network",
                "none",
                "--read-only",
                "--entrypoint",
                "node",
                image,
                "-e",
                program,
            ]
        )
    except (CommandFailed, OSError, subprocess.TimeoutExpired):
        return []
    return [line.strip() for line in result.stdout.decode().splitlines() if line.strip()]


def main(argv=None, server=None):
    parser = argparse.ArgumentParser(prog="lx-deploy", description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    run = commands.add_parser("run", help="deploy release.json if it changed (the timer runs this)")
    run.add_argument("--force", action="store_true", help="deploy and check again even if nothing changed")
    apply = commands.add_parser("apply-config", help="show and apply changed server files (asks first)")
    apply.add_argument("--yes", action="store_true", help=argparse.SUPPRESS)
    commands.add_parser("init-secrets", help="create missing secrets; ask for mail, admin and alert settings")
    check = commands.add_parser("check", help="run the checks now")
    check.add_argument("level", nargs="?", choices=["basic", "full"], default="basic")
    backup_parser = commands.add_parser("backup", help="back up one service, or all")
    backup_parser.add_argument("service", nargs="?", choices=["all", *KNOWN], default="all")
    commands.add_parser("rollback", help="go back to the previous release")
    commands.add_parser("status", help="show what runs now")
    args = parser.parse_args(argv)
    server = server or Server()
    if os.geteuid() != 0 and not os.environ.get("LX_TEST"):
        say("Run lx-deploy as root: sudo lx-deploy ...")
        return 2
    os.umask(0o022)
    try:
        with lock(wait=args.command != "run"):
            if args.command == "run":
                return cmd_run(server, args.force)
            if args.command == "apply-config":
                return cmd_apply_config(server, args.yes)
            if args.command == "init-secrets":
                return cmd_init_secrets(server)
            if args.command == "check":
                return cmd_check(server, args.level)
            if args.command == "backup":
                return cmd_backup(server, args.service)
            if args.command == "rollback":
                return cmd_rollback(server)
            return cmd_status(server)
    except Busy:
        return 0  # another run holds the lock; the timer comes back at its next time


if __name__ == "__main__":
    sys.exit(main())
