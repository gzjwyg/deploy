[Unit]
Description=Look for a new release twice a day (04:00 and 16:00 Hong Kong time)

[Timer]
# The owner's choice (4 Nov 2026): twice a day. For once a day, delete the second line.
OnCalendar=*-*-* 20:00:00 UTC
OnCalendar=*-*-* 08:00:00 UTC
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
